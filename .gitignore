# --- Upstream defaults -------------------------------------------------------
__pycache__/
.ipynb_checkpoints/
.venv/
names.txt
.DS_Store

# Raw working runs stay local; curated copies live in evidence/ and ARE committed.
/llm_runs/
/results/
/chat_transcript.json

# --- Corpus ------------------------------------------------------------------
# Upstream ignores all of corpus/ so private source material is never published
# by accident. Our extension material is synthetic text we wrote ourselves for
# this assignment, so it is deliberately un-ignored: the grader must be able to
# read the teaching examples that the second experiment trains on.
/corpus/*
!/corpus/README.md
!/corpus/extensions/

# --- Corpus sets -------------------------------------------------------------
# McDonald's annual reports / CEO letters ARE published here at the student's
# direction: they are McDonald's own public investor-relations documents, freely
# distributed via SEC EDGAR and the company IR site. See docs/corpus-sources.md.
# Our own synthetic teaching material IS published, so the grader can read it.
!/corpus_sets/targeted/
